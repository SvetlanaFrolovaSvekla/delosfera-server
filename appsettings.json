{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Cors": {
    "//": "Адреса клиента для раздельного развёртывания. За общим reverse-proxy не нужны.",
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174" ]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "delosfera-server",
    "Audience": "delosfera-client",
    "AccessTokenExpiryMinutes": "30",
    "RefreshTokenExpiryDays": "30"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "delosfera-vnd",
    "UseSSL": false
  },
  "Ldap": {
    "Server": "dc01.example.local",
    "Port": 636,
    "UseSsl": true,
    "UsersBaseDn": "OU=Users,DC=example,DC=local",
    "UsersFilter": "(&(objectClass=user)(objectCategory=person))",
    "PageSize": 500,
    "LoginAttribute": "sAMAccountName",
    "EmailAttribute": "mail",
    "FullNameAttribute": "displayName",
    "SyncIntervalMinutes": 60,
    "DefaultRoleId": 2,
    "Enabled": false
  }
}
