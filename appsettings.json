{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=delosfera;Username=postgres;Password=CHANGE_ME"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "CHANGE_ME_use_dotnet_user-secrets_or_env_var",
    "Issuer": "delosfera-server",
    "Audience": "delosfera-client",
    "AccessTokenExpiryMinutes": "30",
    "RefreshTokenExpiryDays": "30"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "CHANGE_ME",
    "SecretKey": "CHANGE_ME",
    "Bucket": "delosfera-vnd",
    "UseSSL": false
  },
  "Ldap": {
    "Server": "dc01.example.local",
    "Port": 636,
    "UseSsl": true,
    "UsersBaseDn": "OU=Users,DC=example,DC=local",
    "UsersFilter": "(&(objectClass=user)(objectCategory=person))",
    "PageSize": 500,
    "LoginAttribute": "sAMAccountName",
    "EmailAttribute": "mail",
    "FullNameAttribute": "displayName",
    "SyncIntervalMinutes": 60,
    "DefaultRoleId": 2,
    "Enabled": false
  }
